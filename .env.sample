SLACK_BOT_TOKEN=YOUR_SLACK_BOT_TOKEN

SOLIDARITY_TECH_API_KEY=YOUR_SOLIDARITY_TECH_API_KEY
# JSON array mapping chapter IDs to Slack channels:
# [{"chapterId":123,"channelId":"C0123456","name":"Washtenaw County","pageUrl":"https://example.com/washtenaw-county-chapter"}]
CHAPTER_CHANNEL_MAPPING=

# Optional: JSON array of case-insensitive substrings. Events whose title
# contains any of these phrases will be excluded.
# Example: ["test event","internal only"]
EXCLUDE_PHRASES=
# Optional: JSON array of case-insensitive substrings matched against each
# session's location_name and location_address. Sessions with a matching
# location are dropped; events with no remaining sessions are excluded.
# Example: ["zoom","HQ"]
EXCLUDE_LOCATIONS=

# --- preview-scope-events script ---
# Slack channel ID to post the nightly scope preview to. Also read by the
# daily digest: reviewers reply in this channel's Monday-morning preview thread
# starting with a chapter's #channel to add that chapter's intro paragraph.
REVIEW_CHANNEL_ID=
# Scope ID to preview (defaults to 1008 if unset)
PREVIEW_SCOPE_ID=1008
